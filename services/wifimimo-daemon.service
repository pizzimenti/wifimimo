[Unit]
Description=wifimimo live data daemon
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/wifimimo-daemon
# After every stop, crash included: hand the radios' autoconnect back to
# NetworkManager (the daemon re-holds them within a poll of starting).
ExecStopPost=/usr/local/bin/wifimimo-daemon --release
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wifimimo-daemon

[Install]
WantedBy=default.target
