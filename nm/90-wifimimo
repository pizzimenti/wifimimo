#!/bin/sh
# wifimimo: per-radio settings and the wifi ECMP multipath after NetworkManager
# link events. Installed root:root 0755 in /etc/NetworkManager/dispatcher.d (NM
# ignores scripts with any other owner or mode). Always exits 0 so a routing
# hiccup never blocks NM.

# Background scan, on every Wi-Fi connection whether or not multipath is on:
# while the signal is above -70 dBm scan every 300 s (a good link isn't
# disturbed), below it every 30 s (a fading link hunts for a better AP).
# wpa_supplicant re-arms bgscan for the current association when it changes, and
# NM writes its own default again on the next connection, so this runs on "up".
if [ "$2" = up ] && [ "$(nmcli -g GENERAL.TYPE dev show "$1" 2>/dev/null)" = wifi ]; then
    wpa_cli -i "$1" set_network 0 bgscan '"simple:30:-70:300"' >/dev/null 2>&1 || true
fi

# Multipath. The helper ignores $1 and rebuilds from live state, so a stale or
# re-ordered event can't leave the wrong layout behind.
[ -e /etc/wifimimo/multipath-enabled ] || exit 0
case "$2" in
    up|down|dhcp4-change|reapply|connectivity-change) ;;
    *) exit 0 ;;
esac
case "$1" in
    lo|tailscale*) exit 0 ;;
esac
timeout 20 /usr/local/lib/wifimimo/wifimimo-helper multipath apply >/dev/null 2>&1 || true
# NM's per-device connectivity check finishes a few seconds after "up", and
# the helper leaves out radios it hasn't cleared yet. When only one radio's
# check completes, global connectivity doesn't change, so no further event
# arrives: schedule re-checks instead. A pending timer with the same name
# makes systemd-run fail, which is fine (a re-check is already queued).
case "$2" in
    up|dhcp4-change)
        for delay in 10 30; do
            systemd-run --quiet --collect --on-active="$delay" --unit="wifimimo-reapply-$delay" \
                /usr/local/lib/wifimimo/wifimimo-helper multipath apply >/dev/null 2>&1 || true
        done
        ;;
esac
exit 0
